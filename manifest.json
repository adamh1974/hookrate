{
  "manifest_version": 3,
  "name": "Hookrate: Reels follows, hooks & best times",
  "version": "0.3.0",
  "description": "See which Facebook Reels bring followers, which hooks hold viewers, and when to post. Your data stays in your browser.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://extensionpay.com/*"
      ],
      "js": [
        "lib/ExtPay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "src/config.js",
        "src/core.js",
        "src/scrape.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "short_name": "Hookrate"
}
